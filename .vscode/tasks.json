{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Blazor (watch)",
      "type": "shell",
      "command": "dotnet watch",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}