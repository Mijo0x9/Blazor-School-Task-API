<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="MyApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @inject IWebHostEnvironment Env

<Routes />
    <script src="_framework/blazor.web.js"></script>

    @if (Env.IsDevelopment())
    {
        <script>
            // Dev-only live reload: reconnect to the SSE endpoint.
            // When the server restarts (dotnet watch on code change),
            // the connection drops and we reload the page.
            (function () {
                function connect() {
                    const es = new EventSource('/dev-reload');
                    es.onerror = function () {
                        es.close();
                        // Server went away (restarting) -> reload once it's back.
                        setTimeout(function () {
                            fetch('/dev-reload', { method: 'GET' })
                                .then(function (r) {
                                    if (r.ok) { location.reload(); }
                                    else { connect(); }
                                })
                                .catch(function () { connect(); });
                        }, 500);
                    };
                }
                connect();
            })();
        </script>
    }
</body>

</html>
