<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Exclude quick-copy templates from the build so they don't cause errors -->
  <ItemGroup>
    <Compile Remove="quick-copy/**" />
    <Content Remove="quick-copy/**" />
    <None Remove="quick-copy/**" />
    <EmbeddedResource Remove="quick-copy/**" />
  </ItemGroup>

</Project>
